From upstream commit 439b452f9fe916a9f7d8788ab6afee8fac846b0b
Subject: avcodec/proresenc_kostya: compute the frame size upper bound in 64 bits
Upstream: https://github.com/FFmpeg/FFmpeg/commit/439b452f9fe916a9f7d8788ab6afee8fac846b0b
Author: Michael Niedermayer

Backported checked 64-bit bound and slice headroom; 9.0.2 predates the redundant per-frame slice calculation.

--- a/libavcodec/proresenc_kostya.c
+++ b/libavcodec/proresenc_kostya.c
@@ -757,7 +757,7 @@
     uint8_t frame_flags;
 
     ctx->pic = pic;
-    pkt_size = ctx->frame_size_upper_bound;
+    pkt_size = ctx->frame_size_upper_bound + ctx->slice_size_upper_bound;
 
     if ((ret = ff_alloc_packet(avctx, pkt, pkt_size + FF_INPUT_BUFFER_MIN_SIZE)) < 0)
         return ret;
--- a/libavcodec/proresenc_kostya_common.c
+++ b/libavcodec/proresenc_kostya_common.c
@@ -24,6 +24,7 @@
 #include "libavutil/pixdesc.h"
 #include "avcodec.h"
 #include "bytestream.h"
+#include "encode.h"
 #include "proresdata.h"
 #include <sys/types.h>
 #include "proresenc_kostya_common.h"
@@ -283,19 +284,27 @@
             ctx->bits_per_mb += ls_chroma * 4;
     }
 
-    ctx->frame_size_upper_bound = (ctx->pictures_per_frame *
+    int64_t frame_size_upper_bound = (int64_t)(ctx->pictures_per_frame *
                                    ctx->slices_per_picture + 1) *
                                   (2 + 2 * ctx->num_planes +
                                    (mps * ctx->bits_per_mb) / 8)
                                   + 200;
+    ctx->slice_size_upper_bound = mps * (ctx->chroma_factor == CFACTOR_Y444 ? 768 : 512) * 8;
 
     if (ctx->alpha_bits) {
          // The alpha plane is run-coded and might exceed the bit budget.
-         ctx->frame_size_upper_bound += (ctx->pictures_per_frame *
-                                         ctx->slices_per_picture + 1) *
-         /* num pixels per slice */     (ctx->mbs_per_slice * 256 *
-         /* bits per pixel */            (1 + ctx->alpha_bits + 1) + 7 >> 3);
-    }
+         int alpha_slice_size = /* num pixels per slice */ mps * 256 *
+                                /* bits per pixel */       (1 + ctx->alpha_bits + 1) + 7 >> 3;
+         frame_size_upper_bound += (int64_t)(ctx->pictures_per_frame *
+                                             ctx->slices_per_picture + 1) * alpha_slice_size;
+         ctx->slice_size_upper_bound += alpha_slice_size;
+    }
+
+    if (frame_size_upper_bound + ctx->slice_size_upper_bound + FF_INPUT_BUFFER_MIN_SIZE > INT_MAX) {
+        av_log(avctx, AV_LOG_ERROR, "Frame too large to encode\n");
+        return AVERROR(EINVAL);
+    }
+    ctx->frame_size_upper_bound = frame_size_upper_bound;
 
     avctx->codec_tag   = ctx->profile_info->tag;
     avctx->profile = ctx->profile;
--- a/libavcodec/proresenc_kostya_common.h
+++ b/libavcodec/proresenc_kostya_common.h
@@ -112,6 +112,7 @@
     int quant_sel;
 
     int frame_size_upper_bound;
+    int slice_size_upper_bound;
 
     int profile;
     const struct prores_profile *profile_info;
