From upstream commit 45f98d0819efe2b7ce93e9034b7e6a4ed6700621
Subject: avcodec/huffyuvenc: reject frames too small for the median predictor
Upstream: https://github.com/FFmpeg/FFmpeg/commit/45f98d0819efe2b7ce93e9034b7e6a4ed6700621
Author: Michael Niedermayer

Upstream changes applied without fuzz; patch context regenerated against the pinned release.

--- a/libavcodec/huffyuvenc.c
+++ b/libavcodec/huffyuvenc.c
@@ -370,6 +370,13 @@
         return AVERROR(EINVAL);
     }
 
+    if (s->predictor == MEDIAN && s->version <= 2 &&
+        (avctx->width < 4 ||
+         AV_CEIL_RSHIFT(avctx->height, s->chroma_v_shift) < 2 + s->interlaced)) {
+        av_log(avctx, AV_LOG_ERROR, "Frame too small for the median predictor\n");
+        return AVERROR(EINVAL);
+    }
+
     avctx->extradata[0] = s->predictor | (s->decorrelate << 6);
     avctx->extradata[2] = s->interlaced ? 0x10 : 0x20;
     if (s->context)
