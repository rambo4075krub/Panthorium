-    ret = check_pixel_ptr(y_ptr, 0, pixel_limit, direction); \
+    ret = check_pixel_ptr(y_ptr, 0, pixel_lo, pixel_hi); \
     if (ret < 0) \
         return ret; \
+}
+
+static void pixel_range(const AVFrame *frame, ptrdiff_t *lo, ptrdiff_t *hi)
+{
+    ptrdiff_t linesize = frame->linesize[0];
+
+    if (linesize > 0) {
+        *lo = 0;
+        *hi = frame->height * linesize;
+    } else {
+        *lo = (frame->height - 1) * linesize;
+        *hi = -linesize;
+    }
 }
 
