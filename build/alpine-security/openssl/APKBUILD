# Contributor: Timo Teras <timo.teras@iki.fi>
# Panthorium: pinned upstream security backports; preserves Alpine packaging.
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=openssl
pkgver=3.5.9
_abiver=${pkgver%.*.*}
pkgrel=1
# Fix the upstream release timestamp for independently reproducible ELF hashes.
export SOURCE_DATE_EPOCH=1790690700
pkgdesc="Toolkit for Transport Layer Security (TLS)"
url="https://www.openssl.org/"
arch="all"
license="Apache-2.0"
provider_priority=100  # highest
makedepends_build="perl python3"
makedepends_host="linux-headers"
makedepends="$makedepends_host $makedepends_build"
install="$pkgname-fips.post-install"
subpackages="
	$pkgname-dbg
	$pkgname-libs-static
	$pkgname-dev
	$pkgname-doc
	$pkgname-misc::noarch
	$pkgname-fips
	libcrypto$_abiver:_libcrypto
	libssl$_abiver:_libssl
	"
source="https://github.com/openssl/openssl/releases/download/openssl-$pkgver/openssl-$pkgver.tar.gz
	auxv.patch
	openssl-159e1de0c448.patch
	openssl-1a73dc590cba.patch
	openssl-a0051cfe699b.patch
	openssl-257a3427aa0e.patch
	openssl-f6244675833e.patch
	openssl-c8f6d04f8e6d.patch
	openssl-9491b0d9cc79.patch
	openssl-f3acb0a33280.patch
	"
builddir="$srcdir/openssl-$pkgver"

