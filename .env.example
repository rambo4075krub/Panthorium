# Panthorium Backend / Sentinel
PORT=8787
HOST=0.0.0.0

# Shared PostgreSQL pool per Node process (all modules use the same pool).
# Recalculate against Cloud SQL capacity before increasing instances or pool size.
DB_POOL_MAX=2
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ลำดับผู้ให้บริการ AI (คั่นด้วย comma)
AI_PRIORITY=groq,openai,gemini,anthropic

# Optional direct calls to a tuned Gemini endpoint (shared, billed per token).
SENTINEL_VERTEX_PROJECT_ID=
SENTINEL_VERTEX_LOCATION=
SENTINEL_VERTEX_ENDPOINT_ID=
SENTINEL_VERTEX_MODEL=sentinel-v3
SENTINEL_VERTEX_MAX_OUTPUT_TOKENS=4096

# API Keys (ใส่เฉพาะที่คุณมี)
GROQ_API_KEY= "",
OPENAI_API_KEY= "",
GEMINI_API_KEY= "",
ANTHROPIC_API_KEY=

# รุ่นโมเดล (ไม่บังคับ)
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Sentinel Control (AI identity เดียว แยกสิทธิ์ด้วย RBAC)
PANTHORIUM_SENTINEL_CONTROL_MODE=observe
PANTHORIUM_SENTINEL_CONTROL_INTERVAL_MS=300000
